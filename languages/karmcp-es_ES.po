#. translators: 1: prop name, 2: attribute name
#: includes/sandbox/class-extension-spec.php:677
msgid "\"%1$s\" (used in attribute \"%2$s\") is not one of the declared props."
msgstr "«%1$s» (usado en el atributo «%2$s») no es una de las props declaradas."

#. translators: 1: attribute name, 2: attribute type
#: includes/sandbox/class-block-generator.php:126
msgid "\"%1$s\" is a %2$s attribute, which is already escaped for its context — the |attr modifier does not apply."
msgstr "«%1$s» es un atributo %2$s, que ya viene escapado para su contexto; el modificador |attr no se aplica."

#. translators: 1: control name, 2: control type
#: includes/sandbox/class-widget-generator.php:140
msgid "\"%1$s\" is a %2$s control, which is already escaped for its context — the |attr modifier does not apply."
msgstr "«%1$s» es un control %2$s, que ya viene escapado para su contexto; el modificador |attr no se aplica."

#. translators: 1: param, 2: documented type, 3: real control type, 4: real label
#: includes/audits/class-catalog-audit.php:88
msgid "\"%1$s\" is documented as %2$s but the control is a %3$s (\"%4$s\"). The description is describing something else."
msgstr "«%1$s» está documentado como %2$s pero el control es un %3$s («%4$s»). La descripción está describiendo otra cosa."

