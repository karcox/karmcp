msgstr "«%1$s» supera los %2$d bytes."

#. translators: 1: sub-property, 2: control name
#: includes/sandbox/class-sandbox-template.php:149
msgid "\"%1$s\" is not a supported sub-property (on \"%2$s\")."
msgstr "«%1$s» no es una subpropiedad admitida (en «%2$s»)."

#. translators: 1: sub-property, 2: attribute name, 3: attribute type
#: includes/sandbox/class-block-generator.php:114
msgid "\"%1$s\" is not available on \"%2$s\" (a %3$s attribute)."
msgstr "«%1$s» no está disponible en «%2$s» (un atributo %3$s)."

#. translators: 1: sub-property, 2: control name, 3: control type
#: includes/sandbox/class-widget-generator.php:128
msgid "\"%1$s\" is not available on \"%2$s\" (a %3$s control)."
msgstr "«%1$s» no está disponible en «%2$s» (un control %3$s)."

#. translators: 1: param name, 2: the selector rule
#: includes/audits/class-catalog-audit.php:121
msgid "\"%1$s\" is not used as given: the widget renders it through \"%2$s\". A value read as a plain length will be wrong by that factor, and nothing reports it."
msgstr "«%1$s» no se usa tal cual: el widget lo renderiza a través de «%2$s». Un valor leído como una longitud normal estará mal por ese factor, y nada lo avisa."

#. translators: 1: param name, 2: widget type
#: includes/audits/class-catalog-audit.php:70
msgid "\"%1$s\" is published for %2$s but the widget registers no such control. Writing it is accepted, stored and never rendered."
msgstr "«%1$s» se publica para %2$s pero el widget no registra ningún control así. Escribirlo se acepta, se guarda y no se renderiza nunca."

#. translators: 1: param, 2: min, 3: max
#: includes/audits/class-catalog-audit.php:105
msgid "\"%1$s\" only accepts %2$s to %3$s, and the description does not say so. A value outside that range is stored without complaint."
msgstr "«%1$s» solo acepta de %2$s a %3$s, y la descripción no lo dice. Un valor fuera de ese rango se guarda sin protestar."

#. translators: %s: field name
#: includes/sandbox/class-sandbox-template.php:243
msgid "\"%s\" contains a <script> tag. Put behaviour in \"scripts\", which is served as a separate file."
msgstr "«%s» contiene una etiqueta <script>. Pon el comportamiento en \"scripts\", que se sirve como archivo aparte."

#. translators: %s: field name
#: includes/sandbox/class-extension-spec.php:733
msgid "\"%s\" contains a PHP open tag. Assets are data, not code."
msgstr "«%s» contiene una etiqueta de apertura de PHP. Los recursos son datos, no código."

#. translators: %s: "styles" or "scripts"
#: includes/sandbox/class-block-spec.php:419
#: includes/sandbox/class-widget-spec.php:433
msgid "\"%s\" contains a PHP open tag. Assets are served as static files."
msgstr "«%s» contiene una etiqueta de apertura de PHP. Los recursos se sirven como archivos estáticos."

#. translators: %s: field name
#: includes/sandbox/class-sandbox-template.php:233
msgid "\"%s\" contains a PHP open tag. Templates are data, not code — the plugin compiles the PHP."
msgstr "«%s» contiene una etiqueta de apertura de PHP. Las plantillas son datos, no código: el PHP lo compila el plugin."

#. translators: %s: field name
#: includes/sandbox/class-sandbox-template.php:263
msgid "\"%s\" contains a javascript: URL."
msgstr "«%s» contiene una URL javascript:."

#. translators: %s: field name
#: includes/sandbox/class-sandbox-template.php:253
msgid "\"%s\" contains an inline event handler attribute. Put behaviour in \"scripts\" and bind it there."
msgstr "«%s» contiene un atributo manejador de eventos en línea. Pon el comportamiento en \"scripts\" y engánchalo allí."

