# What NOT to ship in a release zip.
#
# The build is `git archive --prefix=karmcp/ -o karmcp-<ver>.zip HEAD`, so this
# file IS the release manifest: anything marked export-ignore here is absent
# from the artifact, and everything else tracked in git is included.
#
# vendor/ is deliberately NOT ignored — the MCP Adapter is a committed runtime
# dependency loaded through the Jetpack Autoloader, and the plugin cannot boot
# without it. Do not "clean up" the tree by pruning it.
#
# LICENSE and NOTICE always ship: the licence requires the copyright notices to
# travel with the distribution.

# Repo mechanics
/.gitattributes  export-ignore
/.gitignore      export-ignore
/.github         export-ignore
/.claude         export-ignore

# Development-only
/tests           export-ignore
/docs            export-ignore
/composer.json   export-ignore
/composer.lock   export-ignore
/phpunit.xml     export-ignore
/bin/mcp-proxy.test.mjs export-ignore

# Static analysis. The toolchain lives in tools/ with its own composer.json so
# its dependencies never touch the lock that builds the zip.
/phpcs.xml.dist        export-ignore
/phpstan.neon.dist     export-ignore
/phpstan-baseline.neon export-ignore
/tools                 export-ignore
/bin/check.ps1         export-ignore
/bin/generate-classmap.php export-ignore

# Contributor docs, not user docs
/CLAUDE.md       export-ignore
/CONTRIBUTING.md export-ignore
/SECURITY.md     export-ignore

# Compiled translations are binary. Git's own heuristic already gets this right,
# but a .mo whose byte offsets went through a CRLF conversion is a corrupt file
# that still looks plausible, so it is not left to a heuristic.
*.mo binary

# Generated files whose --check compares rendered bytes (make-pot.php,
# generate-classmap.php). The generators always write LF; on a Windows clone
# with autocrlf, a git checkout would hand back CRLF copies and both checks
# would go red on a clean tree. Pin the working copy to LF so the comparison
# sees what the generator wrote, on every OS.
*.pot                  text eol=lf
*.po                   text eol=lf
/includes/classmap.php text eol=lf
